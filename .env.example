# Copy to .env and set values for this deployment. Never commit your .env.
# Keep your existing password when adding networking settings to an installation.
# A blank password disables management authentication.
STATIONOS_ADMIN_PASSWORD=

# HTTPS origin used by your reverse proxy, without a path. Leave blank for
# direct local access. Used by both standard and discovery-enabled deployments.
STATIONOS_PUBLIC_URL=

# Standard Docker bridge mode (manual UPnP description URLs still work).
# On Linux, enable LAN discovery by changing this to:
# COMPOSE_FILE=compose.yaml:compose.discovery.yaml
COMPOSE_FILE=compose.yaml

# Only used with compose.discovery.yaml. Use 127.0.0.1:8080 when the proxy
# runs on this host and reaches StationOS through loopback. If the proxy runs
# on another server/VM/container, set the StationOS host's reachable LAN
# address and port, for example 192.168.1.20:8080. This address belongs to
# StationOS, not the proxy or music server. Health checks use it too.
STATIONOS_LISTEN_ADDRESS=127.0.0.1:8080
